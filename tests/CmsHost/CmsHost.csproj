<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <CmsUiVersion Condition="'$(CmsUiVersion)' == ''">12.34.6</CmsUiVersion>
    <CmsCoreVersion Condition="'$(CmsCoreVersion)' == ''">12.24.0</CmsCoreVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="EPiServer.CMS" Version="[$(CmsUiVersion)]" />
    <PackageReference Include="EPiServer.Hosting" Version="[$(CmsCoreVersion)]" />
    <PackageReference Include="EPiServer.CMS.AspNetCore.TagHelpers" Version="[$(CmsCoreVersion)]" />
    <PackageReference Include="EPiServer.CMS.AspNetCore.HtmlHelpers" Version="[$(CmsCoreVersion)]" />
    <PackageReference Include="EPiServer.Cms.UI.AspNetIdentity" Version="[$(CmsUiVersion)]" />
    <PackageReference Include="SiteImprove.Optimizely.Plugin" Version="[$(CandidateVersion)]" Condition="'$(CandidateVersion)' != ''" />
  </ItemGroup>
  <Target Name="RequireCandidate" BeforeTargets="PrepareForBuild" Condition="'$(CandidateVersion)' == ''">
    <Error Text="Build through scripts/candidate.py and scripts/host.py; an exact CandidateVersion is required." />
  </Target>
</Project>
