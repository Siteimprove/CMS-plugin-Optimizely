<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="EPiServer.CMS" Version="[12.34.6]" />
    <PackageReference Include="EPiServer.Hosting" Version="[12.24.0]" />
    <PackageReference Include="EPiServer.CMS.AspNetCore.HtmlHelpers" Version="[12.24.0]" />
    <PackageReference Include="EPiServer.Cms.UI.AspNetIdentity" Version="[12.34.6]" />
    <PackageReference Include="SiteImprove.Optimizely.Plugin" Version="[$(CandidateVersion)]" Condition="'$(CandidateVersion)' != ''" />
  </ItemGroup>
  <Target Name="RequireCandidate" BeforeTargets="PrepareForBuild" Condition="'$(CandidateVersion)' == ''">
    <Error Text="Build through scripts/candidate.py and scripts/host.py; an exact CandidateVersion is required." />
  </Target>
</Project>
