@model SiteImprove.Optimizely.Plugin.Models.SettingsViewModel
@using EPiServer.Framework.Web.Resources
@using EPiServer.Shell.Navigation
<!DOCTYPE html>

<html lang="en">
<head>
    <title>@ViewData["Title"]</title>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=Edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    @ClientResources.RenderResources("admin", new[] { ClientResourceType.Style })

    <link rel="stylesheet" href="@Model.SettingsStyleUrl" nonce="@Model.ResourceNonce" />
</head>
<body class="epi-workspace">
    <platform-navigation />
    <noscript>You need to enable JavaScript to run this app.</noscript>
    <platform-navigation-wrapper>
        @RenderBody()
    </platform-navigation-wrapper>

    @RenderSection("AdditionalScripts", false)
</body>
</html>
