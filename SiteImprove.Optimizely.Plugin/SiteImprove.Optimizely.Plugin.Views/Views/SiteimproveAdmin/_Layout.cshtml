@using EPiServer.Framework.Web.Resources
@using EPiServer.Shell.Navigation
<!DOCTYPE html>

<html lang="en">
<head>
    <title>@ViewData["Title"]</title>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=Edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Barlow:300,400,500" />
    @ClientResources.RenderResources("admin", new[] { ClientResourceType.Style })

    <style>
        body {
            margin: 0;
        }

        input[type='text'] {
            border: 0 !important;
            background: none !important;
        }
    </style>
</head>
<body class="epi-workspace">
    <platform-navigation />
    <noscript>You need to enable JavaScript to run this app.</noscript>
    <platform-navigation-wrapper>
        @RenderBody()
    </platform-navigation-wrapper>

    @RenderSection("AdditionalScripts", false)
</body>
</html>