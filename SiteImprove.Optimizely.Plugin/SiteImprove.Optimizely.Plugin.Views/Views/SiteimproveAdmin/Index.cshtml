@model SiteImprove.Optimizely.Plugin.Models.SettingsViewModel
@{
    Layout = "_Layout";
}
<main class="siteimprove-settings">
    <h1>Siteimprove</h1>
    <p>Sign in to Siteimprove from the editor to view page insights and run Prepublish checks. Access depends on your Siteimprove subscription and user permissions.</p>
    <p>This integration uses the current Siteimprove experience. Prepublish checks and highlighting require a preview on the same origin as the CMS.</p>
    <p><a href="https://help.siteimprove.com/support/solutions/articles/80000448234-cms-plugin-security-faq" target="_blank" rel="noopener noreferrer">About Siteimprove sign-in and access</a></p>
    @if (Model.Saved)
    {
        <p role="status" class="settings-saved">Settings saved.</p>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div role="alert" class="settings-errors">
            <h2>Check the URL mappings</h2>
            <p>Your changes have not been saved. Correct the highlighted fields and try again.</p>
            @Html.ValidationSummary(false)
        </div>
    }
    <form action="@Model.PluginUrl/Save" method="post">
        @Html.AntiForgeryToken()
        <h2>Public URL mappings</h2>
        <p id="mapping-help">Optional: map a CMS site's origin to its public origin when they differ. Include http:// or https:// and a port if needed. Page paths stay the same. Leave both fields empty to remove a mapping.</p>
        <table class="settings-mappings">
            <thead><tr><th scope="col">CMS origin</th><th scope="col">Public origin</th></tr></thead>
            <tbody>
                @for (var i = 0; i <= Model.UrlMap.Count; i++)
                {
                    var row = i < Model.UrlMap.Count ? Model.UrlMap[i] : new SiteImprove.Optimizely.Plugin.Models.UrlMapping();
                    <tr>
                        <td>
                            @Html.TextBox($"urlMap[{i}].Key", row.Key, new { aria_label = $"CMS origin, row {i + 1}", aria_invalid = ViewData.ModelState[$"urlMap[{i}].Key"]?.Errors.Count > 0 ? "true" : "false", aria_describedby = $"mapping-help mapping-source-error-{i}", type = "url", placeholder = "https://cms.example.com" })
                            @Html.ValidationMessage($"urlMap[{i}].Key", null, new { id = $"mapping-source-error-{i}" })
                        </td>
                        <td>
                            @Html.TextBox($"urlMap[{i}].Value", row.Value, new { aria_label = $"Public origin, row {i + 1}", aria_invalid = ViewData.ModelState[$"urlMap[{i}].Value"]?.Errors.Count > 0 ? "true" : "false", aria_describedby = $"mapping-help mapping-target-error-{i}", type = "url", placeholder = "https://www.example.com" })
                            @Html.ValidationMessage($"urlMap[{i}].Value", null, new { id = $"mapping-target-error-{i}" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <p>Save to add another mapping row.</p>
        <h2>Published pages</h2>
        <p class="settings-checkbox">
            @Html.CheckBoxFor(model => model.Recheck, new { aria_describedby = "recheck-help" })
            @Html.LabelFor(model => model.Recheck, "Recheck pages after publishing")
        </p>
        <p id="recheck-help">When enabled, publishing a page queues a recheck, including scheduled publishing. Requests are retried if Siteimprove is unavailable. Pending requests are lost if the CMS restarts.</p>
        <button type="submit" class="settings-save">Save settings</button>
    </form>
    <p class="settings-version">Version @Model.PluginVersion</p>
</main>
