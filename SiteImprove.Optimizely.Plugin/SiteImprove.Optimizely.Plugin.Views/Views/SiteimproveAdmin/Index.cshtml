@model SiteImprove.Optimizely.Plugin.Models.SettingsViewModel
@{
    Layout = "_Layout";
}
<main class="siteimprove-settings">
    <h1>Siteimprove</h1>
    <p>Sign in to Siteimprove from the editor to view page insights and run Prepublish checks. Access depends on your Siteimprove subscription and user permissions.</p>
    <p>This integration uses the current Siteimprove experience. Prepublish checks and highlighting require a preview on the same origin as the CMS.</p>
    <p><a href="https://help.siteimprove.com/support/solutions/articles/80000448234-cms-plugin-security-faq" target="_blank" rel="noopener noreferrer">About Siteimprove sign-in and access</a></p>
    @if (Model.Saved)
    {
        <p role="status" class="settings-saved">Settings saved.</p>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div role="alert" class="settings-errors">
            <h2>Check the URL mappings</h2>
            <p>Your changes have not been saved. Correct the highlighted fields and try again.</p>
            @Html.ValidationSummary(false)
        </div>
    }
    <form data-siteimprove-mappings action="@Model.PluginUrl/Save" method="post">
        @Html.AntiForgeryToken()
        <h2>Public URL mappings</h2>
        <p id="mapping-help">Optional: map a CMS site's origin to its public origin when they differ. Include http:// or https:// and a port if needed. Page paths stay the same. Add or remove rows, then save your changes.</p>
        <table class="settings-mappings">
            <thead><tr><th scope="col">CMS origin</th><th scope="col">Public origin</th><th scope="col"><span class="settings-visually-hidden">Actions</span></th></tr></thead>
            <tbody id="mapping-rows">
                @for (var i = 0; i < Math.Max(Model.UrlMap.Count, 1); i++)
                {
                    var row = i < Model.UrlMap.Count ? Model.UrlMap[i] : new SiteImprove.Optimizely.Plugin.Models.UrlMapping();
                    <tr data-mapping-row>
                        <td>
                            @Html.TextBox($"urlMap[{i}].Key", row.Key, new { data_mapping_field = "Key", aria_label = $"CMS origin, row {i + 1}", aria_invalid = ViewData.ModelState[$"urlMap[{i}].Key"]?.Errors.Count > 0 ? "true" : "false", aria_describedby = $"mapping-help mapping-source-error-{i}", type = "url", placeholder = "https://cms.example.com" })
                            <span id="mapping-source-error-@i" data-mapping-error="Key">@Html.ValidationMessage($"urlMap[{i}].Key")</span>
                        </td>
                        <td>
                            @Html.TextBox($"urlMap[{i}].Value", row.Value, new { data_mapping_field = "Value", aria_label = $"Public origin, row {i + 1}", aria_invalid = ViewData.ModelState[$"urlMap[{i}].Value"]?.Errors.Count > 0 ? "true" : "false", aria_describedby = $"mapping-help mapping-target-error-{i}", type = "url", placeholder = "https://www.example.com" })
                            <span id="mapping-target-error-@i" data-mapping-error="Value">@Html.ValidationMessage($"urlMap[{i}].Value")</span>
                        </td>
                        <td><button type="button" class="settings-remove" data-remove-mapping aria-label="Remove mapping row @(i + 1)">Remove</button></td>
                    </tr>
                }
            </tbody>
        </table>
        <template id="mapping-template">
            <tr data-mapping-row>
                <td><input type="url" data-mapping-field="Key" placeholder="https://cms.example.com" aria-invalid="false" /><span data-mapping-error="Key"></span></td>
                <td><input type="url" data-mapping-field="Value" placeholder="https://www.example.com" aria-invalid="false" /><span data-mapping-error="Value"></span></td>
                <td><button type="button" class="settings-remove" data-remove-mapping>Remove</button></td>
            </tr>
        </template>
        <div class="settings-actions">
            <button type="button" id="add-mapping" class="settings-add">Add mapping</button>
            <button type="submit" class="settings-save">Save settings</button>
        </div>
        <p id="mapping-status" role="status" aria-live="polite"></p>
    </form>
    <p class="settings-version">Version @Model.PluginVersion</p>
</main>

@section AdditionalScripts {
    <script src="@Model.MappingScriptUrl" defer></script>
}
